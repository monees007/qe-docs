{
  "name": "qe-docs-reader",
  "private": true,
  "version": "1.0.0",
  "description": "Unofficial, offline-capable reader for the Quantum ESPRESSO documentation",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "ingest": "tsx scripts/ingest/index.ts",
    "icons": "tsx scripts/make-icons.ts",
    "dev": "vite",
    "build": "npm run ingest && npm run verify:data && vue-tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:app": "vue-tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:data": "tsx scripts/ingest/verify.ts",
    "fetch-docs": "tsx scripts/fetch-docs.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "katex": "^0.19.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "cheerio": "^1.2.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
