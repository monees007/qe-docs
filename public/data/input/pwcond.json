display":"outdir","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"temporary directory (as in PWscf)"},{"id":"prefixt","names":["prefixt"],"display":"prefixt","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"prefix for the file (as in PWscf) containing all the regions (left lead + scatt. reg. + right lead)"},{"id":"prefixl","names":["prefixl"],"display":"prefixl","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"prefix for the file containing only the left lead"},{"id":"prefixs","names":["prefixs"],"display":"prefixs","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"prefix for the file containing the scattering region"},{"id":"prefixr","names":["prefixr"],"display":"prefixr","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"prefix for the file containing only the right lead"},{"id":"tran_prefix","names":["tran_prefix"],"display":"tran_prefix","type":"CHARACTER","default":"none","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if tran_prefix is specified the program will save partial results of a transmission calculation (ikind .GE. 1) in a specific directory (outdir/tran_prefix.cond_save)"},{"id":"max_seconds","names":["max_seconds"],"display":"max_seconds","type":"REAL","default":"1.D+7, or 150 days, i.e. no time limit","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"jobs stops after max_seconds elapsed time (wallclock time)."},{"id":"recover","names":["recover"],"display":"recover","type":"LOGICAL","default":".FALSE.","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"restarts a previously interrupted transmission calculation (only if tran_prefix was specified)."},{"id":"band_file","names":["band_file"],"display":"band_file","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"file on which the complex bands are saved"},{"id":"tran_file","names":["tran_file"],"display":"tran_file","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"file where the transmission is written"},{"id":"save_file","names":["save_file"],"display":"save_file","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"file where the data necessary for PWCOND are written so that no prefix files of PW are longer needed"},{"id":"fil_loc","names":["fil_loc"],"display":"fil_loc","type":"CHARACTER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"file on/from which the 2D eigenvalue problem data are saved/read"},{"id":"lwrite_cond","names":["lwrite_cond"],"display":"lwrite_cond","type":"LOGICAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if .t. save the data necessary for PWCOND in save_file"},{"id":"loop_ek","names":["loop_ek"],"display":"loop_ek","type":"LOGICAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if .t. the energy loop is outside the k-point loop"},{"id":"lread_cond","names":["lread_cond"],"display":"lread_cond","type":"LOGICAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if .t. read the data necessary for PWCOND from save_file"},{"id":"lwrite_loc","names":["lwrite_loc"],"display":"lwrite_loc","type":"LOGICAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if .t. save 2D eigenvalue problem result in fil_loc"},{"id":"lread_loc","names":["lread_loc"],"display":"lread_loc","type":"LOGICAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if .t. read 2D eigenvalue problem result from fil_loc"},{"id":"ikind","names":["ikind"],"display":"ikind","type":"INTEGER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"The kind of conductance calculation: ikind=0 - just complex band structure (CBS) calculation ikind=1 - conductance calculation with identical left and right leads ikind=2 - conductance calculation with different left…"},{"id":"iofspin","names":["iofspin"],"display":"iofspin","type":"INTEGER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"spin index for which the calculations are performed"},{"id":"tk_plot","names":["tk_plot"],"display":"tk_plot","type":"INTEGER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if > 0, plot T(kx,ky) at each energy in the region [tk_plot x full BZ]"},{"id":"llocal","names":["llocal"],"display":"llocal","type":"LOGICAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"if .t. calculations are done with only local part of PP"},{"id":"bdl","names":["bdl"],"display":"bdl","type":"REAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"right boundary of the left lead (left one is supposed to be at 0) (in units of lattice parameter \"alat\" defined in the scf run)"},{"id":"bds","names":["bds"],"display":"bds","type":"REAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"right boundary of the scatt. reg."},{"id":"bdr","names":["bdr"],"display":"bdr","type":"REAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"right boundary of the right lead (left one is at 0 if prefixr is used and = bds if prefixt is used) (in units of lattice parameter \"alat\" defined in the scf run)"},{"id":"nz1","names":["nz1"],"display":"nz1","type":"INTEGER","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"the number of subslabs in the slab (to calculate integrals)"},{"id":"energy0","names":["energy0"],"display":"energy0","type":"REAL","sectionId":"INPUTCOND","sectionTitle":"&INPUTCOND","options":[],"summary":"initial energy"},{"id":"denergy","names":["denergy"],"display":"denergy","type":"REAL","s